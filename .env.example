# Server-side only. Never commit .env, never prefix a key with NEXT_PUBLIC_.
# Only the providers you seat need a key; `pnpm game -- --dry-run` needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # optional: GPT models go through OpenRouter by default
OPENROUTER_API_KEY=        # GPT, Llama, DeepSeek, Qwen, Gemini (one key for all)
GOOGLE_API_KEY=

# Supabase (Project Settings → API). URL and anon key are public by design; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, for applying migrations (Project Settings → Database → Connection string → URI)
SUPABASE_DB_URL=

# Live games (web): cost and abuse limits — BRD §9.5 defaults shown
DAILY_BUDGET_USD=2
MAX_GAME_COST_USD=0.25
MAX_LIVE_GAMES_PER_USER_PER_DAY=3
# GitHub numeric user ids allowed into /admin (comma-separated). /admin shows yours once you sign in.
ADMIN_GITHUB_IDS=

# 1 = keep raw request/response in agent-call logs (bench always keeps them)
LOG_RAW=0
