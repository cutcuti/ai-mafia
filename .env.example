# Server-side only. Never commit .env, never prefix a key with NEXT_PUBLIC_.
# Only the providers you seat need a key; `pnpm game -- --dry-run` needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Supabase (Project Settings → API). URL and anon key are public by design; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, for applying migrations (Project Settings → Database → Connection string → URI)
SUPABASE_DB_URL=

# 1 = keep raw request/response in agent-call logs (bench always keeps them)
LOG_RAW=0
