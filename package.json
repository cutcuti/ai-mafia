{
  "name": "ai-mafia",
  "private": true,
  "description": "AI agents play Mafia. Watch them lie.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "game": "tsx --env-file-if-exists=.env packages/agents/src/cli.ts",
    "bench": "tsx --env-file-if-exists=.env packages/bench/src/cli.ts",
    "ratings:rebuild": "tsx --env-file-if-exists=.env packages/bench/src/rebuild.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/bench/src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env packages/bench/src/seed.ts",
    "db:gen-seed": "tsx packages/bench/src/seedsql.ts",
    "db:check": "tsx --env-file-if-exists=.env packages/bench/src/check.ts",
    "web:dev": "pnpm --filter @ai-mafia/web dev",
    "web:build": "pnpm --filter @ai-mafia/web build",
    "e2e": "pnpm --filter @ai-mafia/web e2e",
    "test:llm": "node --env-file-if-exists=.env --import tsx --test packages/agents/tests-llm/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
